# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional but recommended: free key, requested by e-mail at
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Without it, debarment lists (CEIS/CNEP) are reported as "not checked".
PORTAL_TRANSPARENCIA_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
